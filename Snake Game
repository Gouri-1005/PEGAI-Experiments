import pygame
import random
import sys

# -----------------------------
# Initialize Pygame
# -----------------------------
pygame.init()

# Screen settings
WIDTH, HEIGHT = 600, 600
GRID_SIZE = 20
FPS = 10

screen = pygame.display.set_mode((WIDTH, HEIGHT))
pygame.display.set_caption("Snake Game")

clock = pygame.time.Clock()

# Colors
BLACK = (30, 30, 30)
GREEN = (0, 200, 0)
DARK_GREEN = (0, 150, 0)
RED = (220, 50, 50)
WHITE = (255, 255, 255)
GRAY = (180, 180, 180)

# Fonts
font = pygame.font.SysFont("Arial", 28)
big_font = pygame.font.SysFont("Arial", 50)


# ----------------------------------
# Draw score
# ----------------------------------
def draw_score(score):
    text = font.render(f"Score : {score}", True, WHITE)
    screen.blit(text, (10, 10))


# ----------------------------------
# Draw snake
# ----------------------------------
def draw_snake(snake):
    for block in snake:
        pygame.draw.rect(
            screen,
            GREEN,
            (block[0], block[1], GRID_SIZE, GRID_SIZE)
        )
        pygame.draw.rect(
            screen,
            DARK_GREEN,
            (block[0], block[1], GRID_SIZE, GRID_SIZE),
            2
        )


# ----------------------------------
# Generate food
# ----------------------------------
def generate_food(snake):
    while True:
        x = random.randrange(0, WIDTH, GRID_SIZE)
        y = random.randrange(0, HEIGHT, GRID_SIZE)
        if (x, y) not in snake:
            return (x, y)


# ----------------------------------
# Game Over Screen
# ----------------------------------
def game_over_screen(score):

    button = pygame.Rect(WIDTH//2 - 100, HEIGHT//2 + 50, 200, 60)

    while True:

        screen.fill(BLACK)

        title = big_font.render("GAME OVER", True, RED)
        score_text = font.render(f"Final Score : {score}", True, WHITE)

        pygame.draw.rect(screen, GRAY, button)
        restart_text = font.render("Restart", True, BLACK)

        screen.blit(title, title.get_rect(center=(WIDTH//2, 180)))
        screen.blit(score_text, score_text.get_rect(center=(WIDTH//2, 260)))
        screen.blit(restart_text, restart_text.get_rect(center=button.center))

        pygame.display.flip()

        for event in pygame.event.get():

            if event.type == pygame.QUIT:
                pygame.quit()
                sys.exit()

            if event.type == pygame.MOUSEBUTTONDOWN:

                if button.collidepoint(event.pos):
                    return


# ----------------------------------
# Main Game Function
# ----------------------------------
def game():

    snake = [(100, 100)]
    direction = (GRID_SIZE, 0)

    food = generate_food(snake)

    score = 0
    speed = FPS

    while True:

        # ----------------------
        # Events
        # ----------------------
        for event in pygame.event.get():

            if event.type == pygame.QUIT:
                pygame.quit()
                sys.exit()

            if event.type == pygame.KEYDOWN:

                if event.key == pygame.K_UP and direction != (0, GRID_SIZE):
                    direction = (0, -GRID_SIZE)

                elif event.key == pygame.K_DOWN and direction != (0, -GRID_SIZE):
                    direction = (0, GRID_SIZE)

                elif event.key == pygame.K_LEFT and direction != (GRID_SIZE, 0):
                    direction = (-GRID_SIZE, 0)

                elif event.key == pygame.K_RIGHT and direction != (-GRID_SIZE, 0):
                    direction = (GRID_SIZE, 0)

        # ----------------------
        # Move snake
        # ----------------------
        head_x = snake[0][0] + direction[0]
        head_y = snake[0][1] + direction[1]

        new_head = (head_x, head_y)

        # ----------------------
        # Collision detection
        # ----------------------
        if (
            head_x < 0 or
            head_x >= WIDTH or
            head_y < 0 or
            head_y >= HEIGHT or
            new_head in snake
        ):
            game_over_screen(score)
            return

        snake.insert(0, new_head)

        # ----------------------
        # Eat food
        # ----------------------
        if new_head == food:

            score += 1

            # Increase game speed every 5 points
            if score % 5 == 0:
                speed += 2

            food = generate_food(snake)

        else:
            snake.pop()

        # ----------------------
        # Drawing
        # ----------------------
        screen.fill(BLACK)

        pygame.draw.rect(
            screen,
            RED,
            (food[0], food[1], GRID_SIZE, GRID_SIZE)
        )

        draw_snake(snake)

        draw_score(score)

        pygame.display.update()

        clock.tick(speed)


# ----------------------------------
# Run forever
# ----------------------------------
while True:
    game()
